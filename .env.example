# DeskMate Configuration
# Copy this file to .env and fill in your values

# LLM Provider: "mock" (no API key needed) or "gemini"
LLM_PROVIDER=mock

# Gemini API Key (only needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Gemini Model (used when LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-1.5-flash

# Embedding model (local, runs on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_DB_PATH=../data/chroma_db

# SQLite database paths
LOGS_DB_PATH=../data/logs.db
TICKETS_DB_PATH=../data/tickets.db

# Document corpus path
DOCS_PATH=../data/docs

# Retrieval settings
RETRIEVAL_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
